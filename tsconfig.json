{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "module": "NodeNext",
    "noEmit": true,
    "strictNullChecks": true,
    "target": "ESNext",
    "types": ["node"],
    "allowImportingTsExtensions": true
  },
  "include": [
    "**/*.mjs",
    "plugins/**/*.ts",
    "rules/**/*.ts",
    "types/**/*.d.ts",
    "oxfmt.config.ts",
    "oxlint.config.ts"
  ]
}
