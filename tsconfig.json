{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "module": "NodeNext",
    "noEmit": true,
    "strictNullChecks": true,
    "target": "ESNext",
    "types": ["node"]
  },
  "include": [
    "hooks/**/*.mjs",
    "test/validation/**/*.mjs",
    "test/skill-metadata.test.mjs",
    "test/validation.test.mjs",
    "plugins/**/*.ts",
    "rules/**/*.ts",
    "types/**/*.d.ts",
    "oxfmt.config.ts",
    "oxlint.config.ts"
  ]
}
