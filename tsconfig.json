{
  "extends": "@tsconfig/node-lts/tsconfig.json",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "ESNext",
    "allowImportingTsExtensions": true,
    "jsx": "preserve",
    "lib": [
      "esnext",
      "dom",
      "dom.iterable",
      "dom.asynciterable",
      "webworker.importscripts",
      "scripthost"
    ],
    "skipLibCheck": false,
    "moduleResolution": "nodenext"
  },
  "include": [
    "**/*.ts",
    "**/.*/**/*.ts",
    "**/.*.ts",
    "**/.*/**/.*.ts",
    "**/*.tsx",
    "**/.*/**/*.tsx",
    "**/.*.tsx",
    "**/.*/**/.*.tsx",
    "**/*.mts",
    "**/.*/**/*.mts",
    "**/.*.mts",
    "**/.*/**/.*.mts",
    "**/*.cts",
    "**/.*/**/*.cts",
    "**/.*.cts",
    "**/.*/**/.*.cts",
    "**/*.js",
    "**/.*/**/*.js",
    "**/.*.js",
    "**/.*/**/.*.js",
    "**/*.jsx",
    "**/.*/**/*.jsx",
    "**/.*.jsx",
    "**/.*/**/.*.jsx",
    "**/*.mjs",
    "**/.*/**/*.mjs",
    "**/.*.mjs",
    "**/.*/**/.*.mjs",
    "**/*.cjs",
    "**/.*/**/*.cjs",
    "**/.*.cjs",
    "**/.*/**/.*.cjs"
  ],
  "exclude": [
    "**/.git",
    "**/.claude/worktrees",
    ".worktrees",
    "**/coverage",
    "evals/results",
    "**/dist",
    "**/build",
    "**/generated",
    "**/__generated__",
    "**/*.gen.*",
    "**/*.generated.*",
    "**/*.auto.*"
  ]
}
