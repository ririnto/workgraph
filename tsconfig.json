{
  "extends": "@tsconfig/node24/tsconfig.json",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "ESNext",
    "allowImportingTsExtensions": true,
    "jsx": "preserve",
    "lib": [
      "esnext",
      "dom",
      "dom.iterable",
      "dom.asynciterable",
      "webworker.importscripts",
      "scripthost"
    ],
    "skipLibCheck": false,
    "moduleResolution": "nodenext"
  },
  "include": [
    "**/*.mjs",
    "**/*.js",
    "**/*.cjs",
    "**/*.jsx",
    "**/*.ts",
    "**/*.tsx",
    "**/*.mts",
    "**/*.cts"
  ],
  "exclude": [
    "**/.claude/worktrees",
    ".worktrees",
    "**/coverage",
    "evals/results",
    "**/dist",
    "**/build",
    "**/generated",
    "**/__generated__",
    "**/*.gen.*",
    "**/*.generated.*",
    "**/*.auto.*",
    "workflows/*.js"
  ]
}
