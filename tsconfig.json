{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "module": "NodeNext",
    "noEmit": true,
    "strictNullChecks": true,
    "target": "ESNext",
    "types": ["node"],
    "allowImportingTsExtensions": true,
    "jsx": "preserve"
  },
  "include": [
    "**/*.mjs",
    "**/*.js",
    "**/*.cjs",
    "**/*.jsx",
    "**/*.ts",
    "**/*.tsx",
    "**/*.mts",
    "**/*.cts"
  ],
  "exclude": [
    "**/node_modules",
    "**/bower_components",
    "**/jspm_packages",
    "**/.claude/worktrees",
    ".worktrees",
    "**/coverage",
    "evals/results",
    "**/dist",
    "**/build",
    "**/generated",
    "**/__generated__",
    "**/*.gen.*",
    "**/*.generated.*",
    "**/*.auto.*",
    "workflows/*.js"
  ]
}
