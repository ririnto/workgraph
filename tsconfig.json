{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "module": "NodeNext",
    "noEmit": true,
    "strictNullChecks": true,
    "target": "ESNext",
    "types": ["node"]
  },
  "include": [
    "hooks/bash-polling-guard.mjs",
    "hooks/inject-context.mjs",
    "plugins/**/*.ts",
    "rules/**/*.ts",
    "oxfmt.config.ts",
    "oxlint.config.ts"
  ]
}
