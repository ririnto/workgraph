{
  "$schema": "./node_modules/markdownlint-cli2/schema/markdownlint-cli2-config-schema.json",
  "config": {
    "code-block-style": {
      "style": "fenced"
    },
    "docs/no-em-dash": true,
    "docs/no-relative-skill-links": true,
    "docs/prose-format": true,
    "docs/skill-frontmatter": true,
    "docs/table-separators": true,
    "line-length": false,
    "no-duplicate-heading": {
      "siblings_only": true
    },
    "no-emphasis-as-heading": true,
    "no-inline-html": {
      "allowed_elements": ["details", "summary", "kbd", "img", "code"],
      "table_allowed_elements": ["br"]
    },
    "relative-links": {
      "root_path": "."
    },
    "search-replace": {
      "rules": [
        {
          "message": "Use ASCII tree markers such as +-- and | instead.",
          "name": "no-box-drawing",
          "replace": null,
          "searchPattern": "/(?<![\\u2500-\\u257F][^\\n]*)[\\u2500-\\u257F]/gu",
          "searchScope": "all"
        }
      ]
    },
    "single-title": {
      "front_matter_title": ""
    },
    "table-column-style": {
      "style": "compact"
    }
  },
  "customRules": [
    "rules/no-em-dash.ts",
    "rules/prose-format.ts",
    "rules/table-separators.ts",
    "markdownlint-rule-relative-links",
    "markdownlint-rule-search-replace",
    "rules/no-relative-skill-links.ts",
    "rules/skill-frontmatter.ts"
  ],
  "gitignore": true,
  "globs": ["**/*.md"]
}
