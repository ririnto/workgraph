root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
continuation_indent_size = 4
ij_continuation_indent_size = 4

[*.md]
indent_size = 2
continuation_indent_size = 2
ij_continuation_indent_size = 2
max_line_length = unset

[{*.json,*.jsonc}]
indent_size = 2
continuation_indent_size = 2
ij_continuation_indent_size = 2
max_line_length = unset

[{*.mjs,*.ts}]
indent_size = 2
continuation_indent_size = 2
ij_continuation_indent_size = 2
max_line_length = unset

[{*.yaml,*.yml}]
indent_size = 2
continuation_indent_size = 2
ij_continuation_indent_size = 2

[*.sh]
indent_size = 2
continuation_indent_size = 2
ij_continuation_indent_size = 2

[*.{kt,kts}]
ij_kotlin_code_style_defaults = KOTLIN_STYLE_GUIDE
ktlint_code_style = ktlint_official
ktlint_standard_function-expression-body = enabled
ktlint_standard_if-else-bracing = enabled
ktlint_standard_multiline-if-else = enabled
ktlint_standard_no-consecutive-blank-lines = enabled
ktlint_standard_no-unused-imports = enabled
ktlint_standard_trailing-comma-on-call-site = disabled
ktlint_standard_trailing-comma-on-declaration-site = disabled
