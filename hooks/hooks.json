{
  "description": "Inject Workgraph contracts into main and subagent sessions.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/inject-context.mjs",
              "session-start"
            ],
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/inject-context.mjs",
              "subagent-start"
            ],
            "timeout": 5
          }
        ]
      }
    ]
  }
}
