{
  "description": "Inject Workgraph contracts into main and subagent sessions.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/run-hook.cmd\" inject-context session-start",
            "timeout": 5,
            "async": false,
            "shell": "bash",
            "statusMessage": "Loading Workgraph main contract"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/run-hook.cmd\" inject-context subagent-start",
            "timeout": 5,
            "async": false,
            "shell": "bash",
            "statusMessage": "Loading Workgraph node contract"
          }
        ]
      }
    ]
  }
}
