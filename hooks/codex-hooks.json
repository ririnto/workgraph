{
  "description": "Load the selected agent role and Codex host guidance.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/inject-context.mjs\" SessionStart codex",
            "statusMessage": "Load Workgraph main-agent instructions",
            "timeout": 5,
            "additionalContextLimit": 0
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/inject-context.mjs\" SubagentStart codex",
            "statusMessage": "Load Workgraph worker instructions",
            "timeout": 5,
            "additionalContextLimit": 0
          }
        ]
      }
    ]
  }
}
