#!/usr/bin/env sh
set -e

if [ "$#" -ne 1 ]; then
  printf '%s\n' 'inject-context: expected exactly one route' >&2
  exit 2
fi
script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
plugin_root=$(CDPATH= cd -- "$script_dir/.." && pwd)
case "$1" in
  session-start)
    contract_file="$plugin_root/skills/main-agent-contract/SKILL.md"
    event_name='SessionStart'
    ;;
  subagent-start)
    contract_file="$plugin_root/hooks/subagent-context.md"
    event_name='SubagentStart'
    ;;
  *)
    printf 'inject-context: unknown route: %s\n' "$1" >&2
    exit 2
    ;;
esac
if [ ! -r "$contract_file" ]; then
  printf 'inject-context: contract is missing or unreadable: %s\n' "$contract_file" >&2
  exit 1
fi
contract=$(awk '
  { lines[NR] = $0 }
  END {
    first = 1
    last = NR
    while (first <= last) {
      line = lines[first]
      sub(/^[ \t\r]*/, "", line)
      if (line != "") {
        lines[first] = line
        break
      }
      first++
    }
    while (last >= first) {
      line = lines[last]
      sub(/[ \t\r]*$/, "", line)
      if (line != "") {
        lines[last] = line
        break
      }
      last--
    }
    for (line_number = first; line_number <= last; line_number++) {
      line = lines[line_number]
      gsub(/\\/, "&&", line)
      gsub(/"/, "\\\"", line)
      gsub(/\r/, "\\r", line)
      gsub(/\t/, "\\t", line)
      if (line_number > first) printf "\\n"
      printf "%s", line
    }
  }
' "$contract_file")
if [ -z "$contract" ]; then
  printf 'inject-context: contract is empty: %s\n' "$contract_file" >&2
  exit 1
fi
printf '{"hookSpecificOutput":{"hookEventName":"%s","additionalContext":"%s"}}\n' "$event_name" "$contract"
