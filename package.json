{
  "name": "workgraph",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "run-p check:*",
    "check:hooks": "node --test hooks/inject-context.test.mjs",
    "check:issue-forms": "node test/validation/issue-forms.mjs",
    "check:markdownlint-cli2": "markdownlint-cli2",
    "check:plugin-version": "node test/validation/plugin-version.mjs",
    "check:validation-tests": "node --test test/validation.test.mjs",
    "check:ultracite": "ultracite check",
    "fix": "run-p fix:*",
    "fix:markdownlint-cli2": "markdownlint-cli2 --fix",
    "fix:ultracite": "ultracite fix"
  },
  "devDependencies": {
    "markdownlint": "^0.41.1",
    "markdownlint-cli2": "^0.23.3",
    "markdownlint-rule-relative-links": "^5.1.2",
    "npm-run-all2": "^9.0.3",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.87.0",
    "ultracite": "^7.12.4"
  },
  "overrides": {
    "markdownlint-cli2": {
      "smol-toml": "^1.9.1"
    }
  },
  "engines": {
    "node": ">=24.15.0 <25"
  }
}
