{
  "name": "workgraph",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "run-p check:*",
    "check:test": "node --test \"**/*.test.mjs\"",
    "check:issue-forms": "node scripts/issue-forms.mjs",
    "check:markdownlint-cli2": "markdownlint-cli2",
    "check:plugin-version": "node scripts/plugin-version.mjs",
    "check:production-audit": "pnpm audit --prod",
    "check:skill-metadata": "node scripts/skill-metadata.mjs",
    "check:typescript": "tsc --noEmit",
    "check:ultracite": "ultracite check --type-aware --disable-nested-config",
    "test:hooks": "node --test hooks/*.test.mjs",
    "fix": "run-p fix:*",
    "fix:markdownlint-cli2": "markdownlint-cli2 --fix",
    "fix:ultracite": "ultracite fix --type-aware --disable-nested-config",
    "pre-commit": "node scripts/pre-commit-scope.mjs",
    "pre-push": "run-s check",
    "prepare": "husky",
    "check:go": "run-s check:go:golangci check:go:nilaway check:go:consumer",
    "check:go:golangci": "GOWORK=\"$PWD/go.work\" go -C skills/development/assets/golang tool golangci-lint run --config ../../../../.golangci.yaml ./...",
    "check:go:nilaway": "GOWORK=\"$PWD/go.work\" go -C skills/development/assets/golang tool nilaway ./...",
    "check:go:consumer": "node scripts/check-go-consumer.mjs",
    "check:kotlin": "run-s check:kotlin:build-logic check:kotlin:consumer",
    "check:kotlin:build-logic": "skills/development/assets/kotlin/gradlew -p skills/development/assets/kotlin/buildSrc --no-daemon ktlintCheck",
    "check:kotlin:consumer": "node scripts/check-ktlint-consumer.mjs",
    "check:node-consumer": "node scripts/check-node-consumer.mjs",
    "check:shell": "run-s check:shell:format check:shell:lint",
    "check:shell:format": "bash -c 'set -eo pipefail; git ls-files -z -- .husky/pre-commit .husky/pre-push \"*.sh\" | xargs -0 env GOWORK=off go tool shfmt -i 2 -d --'",
    "check:shell:lint": "bash -c 'set -eo pipefail; git ls-files -z -- .husky/pre-commit .husky/pre-push \"*.sh\" | xargs -0 shellcheck --'",
    "check:workflows": "GOWORK=off go tool actionlint",
    "validate:claude": "npm exec --yes --package=@anthropic-ai/claude-code@2.1.305 -- run-s validate:claude:package validate:claude:manifest",
    "validate:claude:package": "claude plugin validate --strict ./",
    "validate:claude:manifest": "claude plugin validate --strict .claude-plugin/plugin.json"
  },
  "devDependencies": {
    "@oxlint/plugins": "catalog:",
    "@tsconfig/node-lts": "catalog:",
    "@types/node": "catalog:",
    "husky": "catalog:",
    "markdownlint": "catalog:",
    "markdownlint-cli2": "catalog:",
    "markdownlint-rule-relative-links": "catalog:",
    "markdownlint-rule-search-replace": "catalog:",
    "npm-run-all2": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "pnpm": "catalog:",
    "typescript": "catalog:",
    "ultracite": "catalog:"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.22.3",
      "onFail": "download"
    }
  },
  "engines": {
    "node": "^24.22.3"
  },
  "packageManager": "pnpm@12.21.0"
}
