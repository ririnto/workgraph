{
  "name": "workgraph",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "run-p check:*",
    "check:hooks": "node --test hooks/inject-context.test.mjs",
    "check:issue-forms": "node test/validation/issue-forms.mjs",
    "check:markdownlint-cli2": "markdownlint-cli2",
    "check:plugin-version": "node test/validation/plugin-version.mjs",
    "check:production-audit": "pnpm audit --prod",
    "check:tooling-tests": "node --test test/tooling.test.mjs",
    "check:ultracite": "run-p --continue-on-error ultracite:check:**",
    "check:validation-tests": "node --test test/validation.test.mjs",
    "fix": "run-p fix:*",
    "fix:markdownlint-cli2": "markdownlint-cli2 --fix",
    "fix:ultracite": "ultracite fix",
    "pre-commit": "run-s check",
    "pre-push": "run-s check",
    "ultracite:check:base": "ultracite check",
    "ultracite:check:style:no-blank-lines-in-functions": "ultracite check --config oxlint.style-no-blank-lines-in-functions.config.ts",
    "ultracite:check:style:no-inline-comments-in-functions": "ultracite check --config oxlint.style-no-inline-comments-in-functions.config.ts",
    "prepare": "husky"
  },
  "devDependencies": {
    "@oxc-project/types": "catalog:",
    "husky": "catalog:",
    "markdownlint": "catalog:",
    "markdownlint-cli2": "catalog:",
    "markdownlint-rule-relative-links": "catalog:",
    "npm-run-all2": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:",
    "ultracite": "catalog:"
  },
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "packageManager": "pnpm@11.28.2"
}
