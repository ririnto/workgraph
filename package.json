{
  "name": "workgraph",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "run-p check:*",
    "check:hooks": "node --test hooks/inject-context.test.mjs",
    "check:markdownlint-cli2": "markdownlint-cli2",
    "check:plugin-version": "node scripts/check-plugin-version.mjs",
    "check:validation-tests": "node --test scripts/validation.test.mjs",
    "check:ultracite": "ultracite check",
    "fix": "run-p fix:*",
    "fix:markdownlint-cli2": "markdownlint-cli2 --fix",
    "fix:ultracite": "ultracite fix"
  },
  "devDependencies": {
    "markdownlint": "^0.41.1",
    "markdownlint-cli2": "^0.23.3",
    "markdownlint-rule-relative-links": "^5.1.2",
    "npm-run-all2": "^9.0.3",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "ultracite": "^7.12.2"
  },
  "engines": {
    "node": ">=24.15.0 <25"
  }
}
