{
  "name": "workgraph",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "run-p check:*",
    "check:test": "run-p check:test:*",
    "check:test:tooling": "node --test \"**/*.test.mjs\"",
    "check:issue-forms": "node test/validation/issue-forms.mjs",
    "check:markdownlint-cli2": "markdownlint-cli2",
    "check:plugin-version": "node test/validation/plugin-version.mjs",
    "check:production-audit": "pnpm audit --prod",
    "check:skill-metadata": "node test/validation/skill-metadata.mjs",
    "check:types": "tsc --noEmit",
    "check:ultracite": "ultracite check",
    "check:ultracite-types": "ultracite check --type-aware oxfmt.config.ts oxlint.config.ts plugins rules hooks/bash-polling-guard.mjs hooks/inject-context.mjs",
    "fix": "run-p fix:*",
    "fix:markdownlint-cli2": "markdownlint-cli2 --fix",
    "fix:ultracite": "ultracite fix",
    "pre-commit": "run-s check",
    "pre-push": "run-s check",
    "prepare": "husky"
  },
  "devDependencies": {
    "@oxc-project/types": "catalog:",
    "@types/node": "catalog:",
    "husky": "catalog:",
    "markdownlint": "catalog:",
    "markdownlint-cli2": "catalog:",
    "markdownlint-rule-relative-links": "catalog:",
    "markdownlint-rule-search-replace": "catalog:",
    "npm-run-all2": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "pnpm": "catalog:",
    "typescript": "catalog:",
    "ultracite": "catalog:"
  },
  "engines": {
    "node": ">=26.13.0 <27"
  },
  "packageManager": "pnpm@12.16.1"
}
